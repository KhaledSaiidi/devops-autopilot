#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="${1:-}"
if [[ -z "${MSG_FILE}" || ! -f "$MSG_FILE" ]]; then
  echo "❌ commit-msg hook: message file is missing."
  exit 1
fi

first_line="$(head -n1 "$MSG_FILE")"

# Allow merge commits generated by Git
if [[ "$first_line" =~ ^Merge\  ]]; then
  echo "✅ Merge commit detected — allowed."
  exit 0
fi

# Conventional Commits:
# type(scope)!: subject
# Types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
type_regex='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|deploy|plan|destroy'
scope_regex='\([a-z0-9._/-]+\)'
bang_regex='!'
subject_regex='[[:space:]]+.+'

pattern="^(${type_regex})((${scope_regex})?)(${bang_regex})?:${subject_regex}$"

if ! [[ "$first_line" =~ $pattern ]]; then
  cat <<'EOF'
❌ Invalid commit message format!

Your commit message must follow Conventional Commits:

  type(optional-scope)!: short summary

Accepted types:
  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test, deploy, plan, destroy

Examples:
  feat(auth): add JWT refresh flow
  fix: handle null pointer on startup
  refactor(core)!: drop legacy v1 APIs
  docs(readme): clarify local setup
  ci(github-actions): cache maven repo
  revert: feat(auth): add JWT refresh flow

Tips:
  • Use lowercase type/scope.
  • Add "!" for breaking changes (and explain in body with "BREAKING CHANGE:").
EOF
  echo
  echo "Your first line was:"
  echo "  $first_line"
  exit 1
fi

subject="${first_line#*: }"
subject_len=${#subject}

if (( subject_len > 72 )); then
  echo "❌ Subject too long (${subject_len} chars). Keep it ≤ 72 chars."
  echo "   Subject: $subject"
  exit 1
fi

if [[ "$subject" =~ \.\s*$ ]]; then
  echo "❌ Remove trailing period from the subject."
  echo "   Subject: $subject"
  exit 1
fi

echo "✅ Commit message accepted."
exit 0
